{
  // Editor
  "editor.fontFamily": "Iosevka Nerd Font Mono, IosevkaTerm Nerd Font Mono, JetBrainsMono Nerd Font Mono, JetBrainsMonoNL Nerd Font Mono, FiraCode Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Hack Nerd Font Mono, SauceCodePro Nerd Font Mono, UbuntuMono Nerd Font Mono, AnonymicePro Nerd Font Mono, Maple Mono NF, Symbols Nerd Font Mono, Menlo, Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.suggestSelection": "first",
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "all",
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.wordWrap": "off",
  "editor.rulers": [
    120
  ],
  "editor.inlayHints.enabled": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": true,
  "editor.mouseWheelScrollSensitivity": 5,
  "editor.accessibilitySupport": "off",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Diff
  "diffEditor.wordWrap": "off",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  // Files
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/*.build": true,
    "**/*.err": true,
    "**/*.rec": true,
    "**/*.evt": true,
    "**/buildfre.*": true,
    "**/buildchk.*": true,
    "**/.DS_Store": true,
    "**/.trunk/*actions/": true,
    "**/.trunk/*logs/": true,
    "**/.trunk/*notifications/": true,
    "**/.trunk/*out/": true,
    "**/.trunk/*plugins/": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.trunk/*actions/": true,
    "**/.trunk/*logs/": true,
    "**/.trunk/*notifications/": true,
    "**/.trunk/*out/": true,
    "**/.trunk/*plugins/": true
  },
  "files.associations": {
    "deque": "cpp",
    "list": "cpp",
    "vector": "cpp",
    "xstring": "cpp"
  },
  // Search
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/coverage": true,
    "**/*.lock": true,
    ".build/**": true,
    "out*/**": true,
    "i18n/**": true,
    "extensions/**/out/**": true,
    "*.min.js": true
  },
  // Workbench
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#1073cf2d",
    "editor.lineHighlightBorder": "#9fced11f"
  },
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.ipynb": "jupyter-notebook",
    "*.md": "default",
    "*.pdf": "pdf.view"
  },
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.restoreViewState": false,
  "window.restoreWindows": "one",
  // Explorer
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false,
  "explorer.incrementalNaming": "smart",
  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.pruneOnFetch": true,
  "git.openRepositoryInParentFolders": "never",
  // Terminal
  "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono, JetBrainsMono Nerd Font Mono, Iosevka Nerd Font Mono, IosevkaTerm Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Hack Nerd Font Mono, SauceCodePro Nerd Font Mono, UbuntuMono Nerd Font Mono, Symbols Nerd Font Mono, Menlo, monospace",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop"
  ],
  "terminal.integrated.defaultProfile.windows": "PowerShell Core",
  "terminal.integrated.profiles.windows": {
    "PowerShell Core": {
      "path": "pwsh.exe",
      "icon": "terminal-powershell",
      "args": [
        "-NoLogo"
      ]
    },
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": [
        "-NoLogo"
      ]
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [
        "/k"
      ],
      "icon": "terminal-cmd"
    }
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "args": [
        "-l"
      ]
    },
    "bash": {
      "path": "/bin/bash",
      "args": [
        "-l"
      ]
    }
  },
  // Notebook
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  // Emmet
  "emmet.triggerExpansionOnTab": true,
  // Indent rainbow
  "indentRainbow.includedLanguages": [],
  "indentRainbow.colorOnWhiteSpaceOnly": true,
  // Trailing spaces
  "trailing-spaces.trimOnSave": true,
  "trailing-spaces.deleteModifiedLinesOnly": true,
  // Prettier
  "prettier.useEditorConfig": true,
  // Language: JSON / JSONC
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  // Language: YAML
  "[yaml]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "diffEditor.ignoreTrimWhitespace": true
  },
  // Language: XML
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  // Language: shell / properties
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[properties]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  // Language: PowerShell
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "editor.tabSize": 2
  },
  // Language: C#
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  // Language: Python (ruff for format + lint)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  // Language: Docker / Compose / Actions
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // Language: TypeScript / TSX
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  // Language: Markdown
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  // Language: Beancount
  "[beancount]": {
    "editor.defaultFormatter": "dongfg.vscode-beancount-formatter"
  },
  "beancountFormatter.fixedCJKWidth": true,
  // Spell check
  "cSpell.enableFiletypes": [
    "lookml",
    "python",
    "markdown",
    "shellscript"
  ],
  "cSpell.userWords": [
    "Agentic",
    "deepseek",
    "Hailey",
    "ollama",
    "openai",
    "openrouter",
    "Qdoba"
  ],
  // Telemetry / updates
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.enableWindowsBackgroundUpdates": false,
  "extensions.autoCheckUpdates": false,
  "extensions.ignoreRecommendations": true,
  // Security / trust
  "security.workspace.trust.untrustedFiles": "prompt",
  "task.allowAutomaticTasks": "on",
  // GitHub PR / Copilot
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.experimental.chat": true,
  "githubPullRequests.experimental.useQuickChat": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  // Claude Code
  "claudeCode.preferredLocation": "panel",
  // Chat / MCP
  "chat.mcp.gallery.enabled": true,
  "yaml.disableSchemaDetection": [
    "azure-pipelines.yml",
    "azure-pipelines.yaml"
  ]
}
